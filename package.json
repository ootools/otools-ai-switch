{
  "name": "otools-ai-switch",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
